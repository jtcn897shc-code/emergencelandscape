---
import { services } from "../data/site";
---

<section id="services" class="section">
  <div class="wrap">
    <h2>Services</h2>
    <p class="services__intro">
      TODO: confirm the real service list and ordering with the client — see
      DISCOVERY.md. Shown highest-intent first once confirmed.
    </p>

    <div class="services__grid">
      {services.map((service) => (
        <article class="services__card reveal">
          <h3>{service.name}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services__intro {
    max-width: 42rem;
    margin-top: var(--space-3);
    color: var(--color-ink);
    opacity: 0.75;
    font-size: var(--font-size-sm);
  }

  .services__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .services__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  /* small stagger so the grid doesn't reveal all at once */
  .services__grid > :nth-child(2) {
    transition-delay: 60ms;
  }
  .services__grid > :nth-child(3) {
    transition-delay: 120ms;
  }
  .services__grid > :nth-child(4) {
    transition-delay: 180ms;
  }

  .services__card h3 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-3);
  }

  .services__card p {
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }

  @media (min-width: 48rem) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
