---
import { services } from "../data/site";
---

<section id="services" class="section">
  <div class="wrap">
    <div class="services__head">
      <h2>What we do</h2>
      <p class="services__note">
        Design, installation, and ongoing care for gardens across the North
        Shore and Langley.
      </p>
    </div>

    <!-- A ruled list, not a grid of cards. Hairlines and numerals carry the
         structure; there is no box, no shadow, no icon badge. -->
    <ol class="services__list">
      {services.map((service, i) => (
        <li class="services__item reveal">
          <span class="services__num">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="services__name">{service.name}</h3>
          <p class="services__desc">{service.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-7);
  }

  .services__note {
    font-size: var(--font-size-base);
    color: var(--color-ink);
    max-width: 38ch;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule);
  }

  .services__item {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: var(--rule);
  }

  .services__num {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-ink);
    opacity: 0.45;
    font-variant-numeric: tabular-nums;
  }

  .services__name {
    font-size: var(--font-size-2xl);
    font-weight: 500;
  }

  .services__desc {
    font-size: var(--font-size-base);
    color: var(--color-ink);
    max-width: 52ch;
  }

  @media (min-width: 48rem) {
    .services__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: var(--space-8);
    }

    /* numeral | name | description — a three-column editorial row */
    .services__item {
      grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: baseline;
      gap: var(--space-6);
      padding-block: var(--space-7);
    }

    .services__num {
      padding-top: 0.4rem;
    }
  }
</style>
