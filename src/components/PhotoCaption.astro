---
interface Props {
  label: string;
  value: string;
  class?: string;
  /**
   * "glass" sits entirely over a photo. "solid" is for a card that straddles
   * the photo's edge — translucency over two different grounds reads muddy.
   */
  variant?: "glass" | "solid";
}

const { label, value, class: className, variant = "glass" } = Astro.props;
---

<figcaption class={`photo-caption photo-caption--${variant} ${className ?? ""}`}>
  <span class="photo-caption__label">{label}</span>
  <span class="photo-caption__value">{value}</span>
</figcaption>

<style>
  .photo-caption {
    position: absolute;
    z-index: 2;
    max-width: 17rem;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .photo-caption--glass {
    background: var(--glass-bg-dark);
    border: 1px solid var(--glass-border-dark);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    color: #fff;
  }

  .photo-caption--solid {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-headline);
    box-shadow: var(--shadow-lg);
  }

  .photo-caption__label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    margin-bottom: var(--space-2);
  }

  .photo-caption--glass .photo-caption__label {
    color: rgb(255 255 255 / 88%);
  }

  .photo-caption--solid .photo-caption__label {
    color: var(--color-accent-strong);
  }

  .photo-caption__value {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: pretty;
  }
</style>
