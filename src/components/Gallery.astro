---
import { images } from "../data/images";
import Figure from "./Figure.astro";

const feature = images.work1;
const secondary = images.work2;
---

<section id="work" class="work section">
  <div class="wrap">
    <div class="work__head">
      <h2>From plan to planted</h2>
      <p class="work__note">Project photography coming soon.</p>
    </div>

    <!-- Deliberately uneven: a wide plate, then a narrower one dropped below
         its baseline, with cream left open around them. Equal tiles in a row
         are what a template produces. -->
    <div class="work__grid">
      <figure class="work__plate work__plate--wide reveal">
        <Figure entry={feature} aspect="3 / 2" sizes="(min-width: 64rem) 66vw, 100vw" />
        <figcaption>Beds, edging and planting, carried from plan to finished property.</figcaption>
      </figure>

      <figure class="work__plate work__plate--tall reveal">
        <Figure entry={secondary} aspect="3 / 4" sizes="(min-width: 64rem) 28vw, 100vw" />
        <figcaption>A second project, to be photographed.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-8);
  }

  .work__note {
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    opacity: 0.65;
  }

  .work__grid {
    display: grid;
    gap: var(--space-8);
  }

  /* clips the reveal's photo scale-in to the frame; the caption below isn't
     affected, since it's in normal flow rather than overflowing the box */
  .work__plate {
    margin: 0;
    overflow: hidden;
  }

  .work__plate--tall {
    transition-delay: 90ms;
  }

  .work__plate figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    max-width: 40ch;
  }

  @media (min-width: 64rem) {
    .work__grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    .work__plate--wide {
      padding-right: var(--space-6);
    }

    .work__plate--tall {
      margin-top: var(--space-10);
    }
  }
</style>
