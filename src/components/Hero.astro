---
import { Image } from "astro:assets";
import { coreArgument, business } from "../data/site";
import { images, brand } from "../data/images";
import Figure from "./Figure.astro";
---

<section id="top" class="hero">
  <div class="hero__media">
    <div class="hero__photo">
      <Figure entry={images.hero} fill hideLabel priority sizes="100vw" />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <!-- The lockup is the hero. Centered, stacked, generously letterspaced —
         the mark and the name are what the visitor is meant to register
         first, not a headline shouting over the photograph. -->
    <div class="hero__lockup">
      <Image
        class="hero__mark"
        src={brand.logoMarkReversed.src}
        alt=""
        width={760}
        height={367}
        loading="eager"
      />
      <h1 class="visually-hidden">{business.name}</h1>
      <p class="hero__name" aria-hidden="true">Emergence</p>
      <p class="hero__sub accent-italic" aria-hidden="true">landscape horticulture</p>
      <p class="hero__areas">{business.serviceAreas.join(" · ")}</p>
    </div>

    <p class="hero__statement">{coreArgument.headline}</p>

    <a href="#services" class="hero__cue" aria-label="Scroll to services">
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero__media {
    position: relative;
    isolation: isolate;
    min-height: clamp(34rem, 88vh, 52rem);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    /* Graded down and slightly desaturated. The ungraded shot is a bright,
       high-saturation render that reads as stock; pulling it darker and
       cooler makes it feel photographed rather than generated. */
    filter: brightness(0.6) saturate(0.78) contrast(1.08);
    animation: hero-settle 1600ms var(--ease-out) both;
  }

  /* pure CSS, so it runs with or without JS; nothing is hidden beforehand */
  @keyframes hero-settle {
    from {
      transform: scale(1.04);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo {
      animation: hero-fade 300ms ease both;
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* Two layers. The radial one sits behind the lockup specifically: the
     logo's pale grey half disappears against a bright sky, and this photo's
     brightest region is exactly where the lockup lands. The linear one
     anchors the top and bottom edges. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 66% 52% at 50% 40%,
        rgb(8 13 5 / 70%) 0%,
        rgb(8 13 5 / 38%) 55%,
        rgb(8 13 5 / 0%) 100%
      ),
      linear-gradient(to bottom, rgb(8 13 5 / 55%) 0%, rgb(8 13 5 / 18%) 40%, rgb(8 13 5 / 72%) 100%);
    pointer-events: none;
  }

  .hero__lockup {
    grid-row: 1;
    z-index: 1;
    align-self: center;
    justify-self: center;
    text-align: center;
    padding: var(--space-8) var(--space-5) 0;
    color: var(--color-bg);
  }

  .hero__mark {
    width: clamp(7rem, 16vw, 11.5rem);
    height: auto;
    margin: 0 auto var(--space-4);
  }

  .hero__name {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0;
    font-weight: 500;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.75rem);
    line-height: 1;
    letter-spacing: 0.16em;
    text-indent: 0.16em; /* balance the trailing letterspace on a centred line */
    text-transform: uppercase;
    color: #fff;
  }

  .hero__sub {
    margin-top: var(--space-3);
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.25rem);
    letter-spacing: 0.06em;
    color: rgb(247 245 238 / 92%);
  }

  .hero__areas {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(247 245 238 / 30%);
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(247 245 238 / 78%);
  }

  /* Small, bottom-left, sentence-cased. Restraint — it supports the lockup
     rather than competing with it. */
  .hero__statement {
    grid-row: 2;
    z-index: 1;
    max-width: 34ch;
    padding: var(--space-6) var(--space-5) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--font-size-hero);
    line-height: 1.45;
    color: rgb(247 245 238 / 94%);
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .hero__statement {
      padding: var(--space-8);
    }
  }

  /* A line, not a chevron icon — the house style dropped icon badges
     everywhere else, and a bouncing arrow is its own kind of template tell.
     Purpose: invite the scroll. It's a real link to #services, not a purely
     decorative cue. */
  .hero__cue {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-6);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
  }

  .hero__cue-line {
    width: 1px;
    height: 1.75rem;
    background: rgb(247 245 238 / 55%);
    animation: hero-cue-drip 2200ms var(--ease-in-out) infinite;
    transition: background-color var(--duration-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__cue:hover .hero__cue-line {
      background: rgb(247 245 238 / 92%);
    }
  }

  @keyframes hero-cue-drip {
    0% {
      transform: scaleY(0.3) translateY(-0.3rem);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    70% {
      transform: scaleY(1) translateY(0.4rem);
      opacity: 1;
    }
    100% {
      transform: scaleY(0.3) translateY(0.8rem);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line {
      animation: none;
      opacity: 0.55;
    }
  }

  @media (min-width: 48rem) {
    .hero__cue {
      right: var(--space-8);
      bottom: var(--space-8);
    }
  }
</style>
