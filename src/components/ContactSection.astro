---
import { business, contactIntake } from "../data/site";
---

<section id="contact" class="contact section">
  <div class="wrap contact__grid">
    <div>
      <h2>{contactIntake.heading}</h2>
      <p class="contact__body">{contactIntake.body}</p>

      <ul class="contact__checklist">
        {contactIntake.checklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="contact__card">
      <p class="contact__card-label">Reach us directly</p>

      <a class="contact__link" href={business.phoneHref}>
        <span class="contact__link-label">Call</span>
        <span>{business.phone}</span>
      </a>

      <a class="contact__link" href={`mailto:${business.email}`}>
        <span class="contact__link-label">Email</span>
        <span>{business.email}</span>
      </a>

      <a class="contact__link" href={business.facebookUrl} target="_blank" rel="noopener noreferrer">
        <span class="contact__link-label">Message</span>
        <span>{business.messenger}</span>
      </a>

      <a class="btn btn--primary contact__cta" href={business.phoneHref}>
        Call {business.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-7);
  }

  .contact__body {
    margin-top: var(--space-4);
    font-size: var(--font-size-lg);
    max-width: 34rem;
  }

  .contact__checklist {
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink);
  }

  .contact__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: fit-content;
  }

  .contact__card-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-accent-strong);
  }

  .contact__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--duration-fast) ease;
  }

  .contact__link:hover {
    color: var(--color-accent-strong);
  }

  .contact__link-label {
    font-size: var(--font-size-xs);
    color: var(--color-ink);
    opacity: 0.7;
  }

  .contact__cta {
    margin-top: var(--space-2);
    width: 100%;
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
