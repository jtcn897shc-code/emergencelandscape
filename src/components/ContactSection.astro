---
import { business, contactIntake } from "../data/site";
---

<section id="contact" class="contact section">
  <div class="wrap contact__grid">
    <div>
      <h2>{contactIntake.heading}</h2>
      <p class="lede">{contactIntake.body}</p>
      <a class="action contact__action" href={business.phoneHref}>
        Call {business.phone}
      </a>
    </div>

    <div class="contact__details">
      <dl class="contact__list">
        <div class="contact__row">
          <dt>Telephone</dt>
          <dd><a href={business.phoneHref}>{business.phone}</a></dd>
        </div>
        <div class="contact__row">
          <dt>Email</dt>
          <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
        </div>
        <div class="contact__row">
          <dt>Messenger</dt>
          <dd>
            <a href={business.facebookUrl} target="_blank" rel="noopener noreferrer">
              {business.messenger}
            </a>
          </dd>
        </div>
      </dl>

      <div class="contact__helpful">
        <p class="eyebrow">Helpful to include</p>
        <ul class="contact__checklist">
          {contactIntake.checklist.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }

  .contact__action {
    margin-top: var(--space-6);
  }

  .contact__list {
    margin: 0;
    border-top: var(--rule);
  }

  .contact__row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: var(--rule);
  }

  .contact__row dt {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink);
    opacity: 0.55;
  }

  .contact__row dd {
    margin: 0;
    font-size: var(--font-size-lg);
    color: var(--color-headline);
  }

  .contact__row a {
    text-decoration: none;
  }

  .contact__row a:hover {
    text-decoration: underline;
  }

  .contact__helpful {
    margin-top: var(--space-7);
  }

  .contact__checklist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__checklist li {
    padding-block: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-10);
    }

    .contact__row {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-4);
    }
  }
</style>
