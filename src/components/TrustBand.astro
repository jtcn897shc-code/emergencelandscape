---
import { business } from "../data/site";

// Only confirmed facts render here — see PLAYBOOK.md §5.2: no invented
// "18+ years" or job counts. We have real service areas and the business's
// own specialization (horticulture, not just landscaping) to show instead.
const points = [
  { label: "Service area", value: business.serviceAreas.join(" · ") },
  { label: "Specialization", value: "Horticulture-trained garden care" },
  { label: "Reach us", value: business.phone },
];
---

<section class="trust section--tight" aria-label="Service area and specialization">
  <div class="wrap trust__grid">
    {points.map((point) => (
      <div class="trust__item">
        <p class="trust__label">{point.label}</p>
        <p class="trust__value">{point.value}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--color-sage-tint);
    border-block: 1px solid var(--color-border);
  }

  .trust__grid {
    display: grid;
    gap: var(--space-5);
  }

  .trust__label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-strong);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .trust__value {
    font-weight: 600;
    color: var(--color-headline);
  }

  @media (min-width: 48rem) {
    .trust__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
