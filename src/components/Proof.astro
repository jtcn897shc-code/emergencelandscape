---
import { images } from "../data/images";
import Figure from "./Figure.astro";

const entry = images.proof;
---

<section class="proof section">
  <div class="wrap proof__grid">
    <div class="proof__copy reveal">
      <h2>Why "horticulture"<br />is in the name</h2>
      <p class="lede">
        Plenty of outfits mow, blow, and move on. Horticulture means starting
        from what a plant actually needs to thrive — soil, light, water, and
        the right species for the spot it's going in.
      </p>
      <p class="proof__note accent-italic">
        Soil, siting and species, chosen for how the plant actually grows.
      </p>
    </div>

    <figure class="proof__figure reveal">
      <Figure entry={entry} aspect="4 / 5" sizes="(min-width: 64rem) 42vw, 100vw" />
    </figure>
  </div>
</section>

<style>
  .proof__grid {
    display: grid;
    gap: var(--space-7);
  }

  .proof__note {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--rule-strong);
    font-size: var(--font-size-lg);
    color: var(--color-headline);
    max-width: 34ch;
  }

  .proof__figure {
    margin: 0;
    overflow: hidden; /* clips the reveal's photo scale-in to the frame */
  }

  /* the photo trails the copy in slightly, rather than both arriving at once */
  .proof__figure {
    transition-delay: 90ms;
  }

  @media (min-width: 64rem) {
    .proof__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      gap: var(--space-10);
      align-items: start;
    }

    .proof__copy {
      padding-top: var(--space-8);
    }

    /* pushed down out of alignment on purpose — a staggered baseline reads
       as composed, where two tops flush to the same line reads as a grid */
    .proof__figure {
      margin-top: calc(var(--space-10) * -1);
    }
  }
</style>
