---
import { Image } from "astro:assets";
import { about, business } from "../data/site";
import { brand } from "../data/images";
---

<section id="about" class="about section">
  <div class="wrap">
    <div class="about__panel reveal">
      <Image
        class="about__watermark"
        src={brand.logoMarkReversed.src}
        alt=""
        width={520}
        height={251}
        aria-hidden="true"
      />

      <div class="about__inner">
        <p class="eyebrow about__eyebrow">{about.heading}</p>
        <p class="about__statement">{about.body}</p>

        <dl class="about__facts">
          <div>
            <dt>Direct line</dt>
            <dd><a href={business.phoneHref}>{business.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-dark);
    color: var(--color-dark-ink);
    padding: var(--space-9) var(--space-6);
  }

  .about__watermark {
    position: absolute;
    z-index: -1;
    right: -6%;
    bottom: -18%;
    width: min(32rem, 60%);
    height: auto;
    opacity: 0.07;
    pointer-events: none;
  }

  .about__inner {
    max-width: 52rem;
  }

  .about__eyebrow {
    color: rgb(247 245 238 / 62%);
    opacity: 1;
  }

  /* the statement is the section — no photo, so the type carries it */
  .about__statement {
    font-size: clamp(1.375rem, 1.05rem + 1.4vw, 2rem);
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72, "SOFT" 20, "WONK" 0;
    font-weight: 400;
    line-height: 1.34;
    letter-spacing: 0;
    color: #fff;
    text-wrap: pretty;
  }

  .about__facts {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: var(--rule-on-dark);
  }

  .about__facts dt {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: rgb(247 245 238 / 60%);
    margin-bottom: var(--space-2);
  }

  .about__facts dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-dark-ink);
  }

  .about__facts a {
    text-decoration: none;
  }

  .about__facts a:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .about__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .about__panel {
      padding: var(--space-9) var(--space-8);
    }
  }
</style>
